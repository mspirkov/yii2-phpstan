parameters:
	dynamicConstantNames:
		- YII_DEBUG
		- YII_ENV
		- YII_ENV_DEV
		- YII_ENV_PROD
		- YII_ENV_TEST

	mspirkovYii2:
		enableAllRules: true
		enableValidationRules: %mspirkovYii2.enableAllRules%
		yiiAppDbProperties:
			- db
		baseObjectConfigValidation:
			skippedClasses: []
		aliases: []
		viewExtensions:
			- php
		viewPaths: []
		applicationConfigs: []
		yiiAppTypes: []
		actionComplexity:
			ifCount: 3
			foreachCount: 0
			forCount: 0
			whileCount: 0
			doWhileCount: 0
			switchCount: 0
			matchCount: 0
			ternaryCount: 1
			tryCatchCount: 1
		activeFormFieldValidation:
			enabled: %mspirkovYii2.enableValidationRules%
		activeQueryWithValidation:
			enabled: %mspirkovYii2.enableValidationRules%
		activeRecordConditionValidation:
			enabled: %mspirkovYii2.enableValidationRules%
		activeRecordRelationValidation:
			enabled: %mspirkovYii2.enableValidationRules%
		activeRecordUpdateValuesValidation:
			enabled: %mspirkovYii2.enableValidationRules%
		baseObjectInstantiationValidation:
			enabled: %mspirkovYii2.enableValidationRules%
		behaviorAttributesValidation:
			enabled: %mspirkovYii2.enableValidationRules%
		componentBehaviorsValidation:
			enabled: %mspirkovYii2.enableValidationRules%
		controllerActionsValidation:
			enabled: %mspirkovYii2.enableValidationRules%
		controllerBehaviorActionsValidation:
			enabled: %mspirkovYii2.enableValidationRules%
		controllerViewExistenceValidation:
			enabled: %mspirkovYii2.enableValidationRules%
		htmlActiveAttributeValidation:
			enabled: %mspirkovYii2.enableValidationRules%
		modelAttributeHintsValidation:
			enabled: %mspirkovYii2.enableValidationRules%
			skippedClasses: []
		modelAttributeLabelsValidation:
			enabled: %mspirkovYii2.enableValidationRules%
			skippedClasses: []
		modelRulesValidation:
			enabled: %mspirkovYii2.enableValidationRules%
			customValidators: []
		modelScenariosValidation:
			enabled: %mspirkovYii2.enableValidationRules%
		nestedViewExistenceValidation:
			enabled: %mspirkovYii2.enableValidationRules%
		queryConditionValidation:
			enabled: %mspirkovYii2.enableValidationRules%
		uploadedFileInstanceValidation:
			enabled: %mspirkovYii2.enableValidationRules%
		viewRenderExistenceValidation:
			enabled: %mspirkovYii2.enableValidationRules%
		widgetPropertiesValidation:
			enabled: %mspirkovYii2.enableValidationRules%
		yiiCreateObjectValidation:
			enabled: %mspirkovYii2.enableValidationRules%
		noComplexActionClasses:
			enabled: %mspirkovYii2.enableAllRules%
		noComplexControllerActions:
			enabled: %mspirkovYii2.enableAllRules%
		noControllerActionCallsViaThis:
			enabled: %mspirkovYii2.enableAllRules%
		noDbQueriesInActions:
			enabled: %mspirkovYii2.enableAllRules%
		noDbQueriesInControllers:
			enabled: %mspirkovYii2.enableAllRules%
		noDbQueriesInViews:
			enabled: %mspirkovYii2.enableAllRules%
		noDirectSuperglobals:
			enabled: %mspirkovYii2.enableAllRules%
		noDynamicQueryWhere:
			enabled: %mspirkovYii2.enableAllRules%
		noForbiddenYiiAppProperties:
			enabled: %mspirkovYii2.enableAllRules%
			allowedProperties:
				- id
				- name
				- charset
				- language
				- timeZone
		noRedundantExistenceCheck:
			enabled: %mspirkovYii2.enableAllRules%
		noRedundantHtmlEncode:
			enabled: %mspirkovYii2.enableAllRules%
		noYiiAppPropertyMutation:
			enabled: %mspirkovYii2.enableAllRules%

parametersSchema:
	mspirkovYii2: structure([
		enableAllRules: bool()
		enableValidationRules: bool()
		yiiAppDbProperties: arrayOf(string())
		baseObjectConfigValidation: structure([
			skippedClasses: listOf(structure([
				class: string()
				?attributes: listOf(string())
			]))
		])
		aliases: arrayOf(string())
		viewExtensions: listOf(string())
		viewPaths: arrayOf(string())
		applicationConfigs: listOf(structure([
			paths: listOf(string())
			files: listOf(string())
		]))
		yiiAppTypes: listOf(structure([
			paths: listOf(string())
			?type: string()
			?nullable: bool()
		]))
		actionComplexity: structure([
			ifCount: int()
			foreachCount: int()
			forCount: int()
			whileCount: int()
			doWhileCount: int()
			switchCount: int()
			matchCount: int()
			ternaryCount: int()
			tryCatchCount: int()
		])
		activeFormFieldValidation: structure([
			enabled: bool()
		])
		activeQueryWithValidation: structure([
			enabled: bool()
		])
		activeRecordConditionValidation: structure([
			enabled: bool()
		])
		activeRecordRelationValidation: structure([
			enabled: bool()
		])
		activeRecordUpdateValuesValidation: structure([
			enabled: bool()
		])
		baseObjectInstantiationValidation: structure([
			enabled: bool()
		])
		behaviorAttributesValidation: structure([
			enabled: bool()
		])
		componentBehaviorsValidation: structure([
			enabled: bool()
		])
		controllerActionsValidation: structure([
			enabled: bool()
		])
		controllerBehaviorActionsValidation: structure([
			enabled: bool()
		])
		controllerViewExistenceValidation: structure([
			enabled: bool()
		])
		htmlActiveAttributeValidation: structure([
			enabled: bool()
		])
		modelAttributeHintsValidation: structure([
			enabled: bool()
			skippedClasses: listOf(structure([
				class: string()
				?attributes: listOf(string())
			]))
		])
		modelAttributeLabelsValidation: structure([
			enabled: bool()
			skippedClasses: listOf(structure([
				class: string()
				?attributes: listOf(string())
			]))
		])
		modelRulesValidation: structure([
			enabled: bool()
			customValidators: arrayOf(string())
		])
		modelScenariosValidation: structure([
			enabled: bool()
		])
		nestedViewExistenceValidation: structure([
			enabled: bool()
		])
		queryConditionValidation: structure([
			enabled: bool()
		])
		uploadedFileInstanceValidation: structure([
			enabled: bool()
		])
		viewRenderExistenceValidation: structure([
			enabled: bool()
		])
		widgetPropertiesValidation: structure([
			enabled: bool()
		])
		yiiCreateObjectValidation: structure([
			enabled: bool()
		])
		noComplexActionClasses: structure([
			enabled: bool()
		])
		noComplexControllerActions: structure([
			enabled: bool()
		])
		noControllerActionCallsViaThis: structure([
			enabled: bool()
		])
		noDbQueriesInActions: structure([
			enabled: bool()
		])
		noDbQueriesInControllers: structure([
			enabled: bool()
		])
		noDbQueriesInViews: structure([
			enabled: bool()
		])
		noDirectSuperglobals: structure([
			enabled: bool()
		])
		noDynamicQueryWhere: structure([
			enabled: bool()
		])
		noForbiddenYiiAppProperties: structure([
			enabled: bool()
			allowedProperties: arrayOf(string())
		])
		noRedundantExistenceCheck: structure([
			enabled: bool()
		])
		noRedundantHtmlEncode: structure([
			enabled: bool()
		])
		noYiiAppPropertyMutation: structure([
			enabled: bool()
		])
	])

conditionalTags:
	MSpirkov\Yii2\PHPStan\Rules\ActiveFormFieldValidationRule:
		phpstan.rules.rule: %mspirkovYii2.activeFormFieldValidation.enabled%
	MSpirkov\Yii2\PHPStan\Rules\ActiveQueryWithValidationRule:
		phpstan.rules.rule: %mspirkovYii2.activeQueryWithValidation.enabled%
	MSpirkov\Yii2\PHPStan\Rules\ActiveRecordConditionValidationRule:
		phpstan.rules.rule: %mspirkovYii2.activeRecordConditionValidation.enabled%
	MSpirkov\Yii2\PHPStan\Rules\ActiveRecordRelationValidationRule:
		phpstan.rules.rule: %mspirkovYii2.activeRecordRelationValidation.enabled%
	MSpirkov\Yii2\PHPStan\Rules\ActiveRecordUpdateValuesValidationRule:
		phpstan.rules.rule: %mspirkovYii2.activeRecordUpdateValuesValidation.enabled%
	MSpirkov\Yii2\PHPStan\Rules\BaseObjectInstantiationValidationRule:
		phpstan.rules.rule: %mspirkovYii2.baseObjectInstantiationValidation.enabled%
	MSpirkov\Yii2\PHPStan\Rules\BehaviorAttributesValidationRule:
		phpstan.rules.rule: %mspirkovYii2.behaviorAttributesValidation.enabled%
	MSpirkov\Yii2\PHPStan\Rules\ComponentBehaviorsValidationRule:
		phpstan.rules.rule: %mspirkovYii2.componentBehaviorsValidation.enabled%
	MSpirkov\Yii2\PHPStan\Rules\ControllerActionsValidationRule:
		phpstan.rules.rule: %mspirkovYii2.controllerActionsValidation.enabled%
	MSpirkov\Yii2\PHPStan\Rules\ControllerBehaviorActionsValidationRule:
		phpstan.rules.rule: %mspirkovYii2.controllerBehaviorActionsValidation.enabled%
	MSpirkov\Yii2\PHPStan\Rules\ControllerViewExistenceValidationRule:
		phpstan.rules.rule: %mspirkovYii2.controllerViewExistenceValidation.enabled%
	MSpirkov\Yii2\PHPStan\Rules\HtmlActiveAttributeValidationRule:
		phpstan.rules.rule: %mspirkovYii2.htmlActiveAttributeValidation.enabled%
	MSpirkov\Yii2\PHPStan\Rules\ModelAttributeHintsValidationRule:
		phpstan.rules.rule: %mspirkovYii2.modelAttributeHintsValidation.enabled%
	MSpirkov\Yii2\PHPStan\Rules\ModelAttributeLabelsValidationRule:
		phpstan.rules.rule: %mspirkovYii2.modelAttributeLabelsValidation.enabled%
	MSpirkov\Yii2\PHPStan\Rules\ModelRulesValidationRule:
		phpstan.rules.rule: %mspirkovYii2.modelRulesValidation.enabled%
	MSpirkov\Yii2\PHPStan\Rules\ModelScenariosValidationRule:
		phpstan.rules.rule: %mspirkovYii2.modelScenariosValidation.enabled%
	MSpirkov\Yii2\PHPStan\Rules\NestedViewExistenceValidationRule:
		phpstan.rules.rule: %mspirkovYii2.nestedViewExistenceValidation.enabled%
	MSpirkov\Yii2\PHPStan\Rules\QueryConditionValidationRule:
		phpstan.rules.rule: %mspirkovYii2.queryConditionValidation.enabled%
	MSpirkov\Yii2\PHPStan\Rules\UploadedFileInstanceValidationRule:
		phpstan.rules.rule: %mspirkovYii2.uploadedFileInstanceValidation.enabled%
	MSpirkov\Yii2\PHPStan\Rules\ViewRenderExistenceValidationRule:
		phpstan.rules.rule: %mspirkovYii2.viewRenderExistenceValidation.enabled%
	MSpirkov\Yii2\PHPStan\Rules\WidgetPropertiesValidationRule:
		phpstan.rules.rule: %mspirkovYii2.widgetPropertiesValidation.enabled%
	MSpirkov\Yii2\PHPStan\Rules\YiiCreateObjectValidationRule:
		phpstan.rules.rule: %mspirkovYii2.yiiCreateObjectValidation.enabled%
	MSpirkov\Yii2\PHPStan\Rules\NoComplexActionClassesRule:
		phpstan.rules.rule: %mspirkovYii2.noComplexActionClasses.enabled%
	MSpirkov\Yii2\PHPStan\Rules\NoComplexControllerActionsRule:
		phpstan.rules.rule: %mspirkovYii2.noComplexControllerActions.enabled%
	MSpirkov\Yii2\PHPStan\Rules\NoControllerActionCallsViaThisRule:
		phpstan.rules.rule: %mspirkovYii2.noControllerActionCallsViaThis.enabled%
	MSpirkov\Yii2\PHPStan\Rules\NoDbQueriesInActionsRule:
		phpstan.rules.rule: %mspirkovYii2.noDbQueriesInActions.enabled%
	MSpirkov\Yii2\PHPStan\Rules\NoDbQueriesInControllersRule:
		phpstan.rules.rule: %mspirkovYii2.noDbQueriesInControllers.enabled%
	MSpirkov\Yii2\PHPStan\Rules\NoDbQueriesInViewsRule:
		phpstan.rules.rule: %mspirkovYii2.noDbQueriesInViews.enabled%
	MSpirkov\Yii2\PHPStan\Rules\NoDirectSuperglobalsRule:
		phpstan.rules.rule: %mspirkovYii2.noDirectSuperglobals.enabled%
	MSpirkov\Yii2\PHPStan\Rules\NoDynamicQueryWhereRule:
		phpstan.rules.rule: %mspirkovYii2.noDynamicQueryWhere.enabled%
	MSpirkov\Yii2\PHPStan\Rules\NoForbiddenYiiAppPropertiesRule:
		phpstan.rules.rule: %mspirkovYii2.noForbiddenYiiAppProperties.enabled%
	MSpirkov\Yii2\PHPStan\Rules\NoRedundantExistenceCheckRule:
		phpstan.rules.rule: %mspirkovYii2.noRedundantExistenceCheck.enabled%
	MSpirkov\Yii2\PHPStan\Rules\NoRedundantHtmlEncodeRule:
		phpstan.rules.rule: %mspirkovYii2.noRedundantHtmlEncode.enabled%
	MSpirkov\Yii2\PHPStan\Rules\NoYiiAppPropertyMutationRule:
		phpstan.rules.rule: %mspirkovYii2.noYiiAppPropertyMutation.enabled%

services:
	-
		class: MSpirkov\Yii2\PHPStan\Rules\ActiveFormFieldValidationRule
	-
		class: MSpirkov\Yii2\PHPStan\Rules\ActiveQueryWithValidationRule
	-
		class: MSpirkov\Yii2\PHPStan\Rules\ActiveRecordConditionValidationRule
	-
		class: MSpirkov\Yii2\PHPStan\Rules\ActiveRecordRelationValidationRule
	-
		class: MSpirkov\Yii2\PHPStan\Rules\ActiveRecordUpdateValuesValidationRule
	-
		class: MSpirkov\Yii2\PHPStan\Rules\BaseObjectInstantiationValidationRule
	-
		class: MSpirkov\Yii2\PHPStan\Rules\BehaviorAttributesValidationRule
	-
		class: MSpirkov\Yii2\PHPStan\Rules\ComponentBehaviorsValidationRule
	-
		class: MSpirkov\Yii2\PHPStan\Rules\ControllerActionsValidationRule
	-
		class: MSpirkov\Yii2\PHPStan\Rules\ControllerBehaviorActionsValidationRule
	-
		class: MSpirkov\Yii2\PHPStan\Rules\ControllerViewExistenceValidationRule
	-
		class: MSpirkov\Yii2\PHPStan\Rules\HtmlActiveAttributeValidationRule
	-
		class: MSpirkov\Yii2\PHPStan\Rules\ModelAttributeHintsValidationRule
		arguments:
			skippedClasses: %mspirkovYii2.modelAttributeHintsValidation.skippedClasses%
	-
		class: MSpirkov\Yii2\PHPStan\Rules\ModelAttributeLabelsValidationRule
		arguments:
			skippedClasses: %mspirkovYii2.modelAttributeLabelsValidation.skippedClasses%
	-
		class: MSpirkov\Yii2\PHPStan\Rules\ModelRulesValidationRule
		arguments:
			customValidators: %mspirkovYii2.modelRulesValidation.customValidators%
	-
		class: MSpirkov\Yii2\PHPStan\Rules\ModelScenariosValidationRule
	-
		class: MSpirkov\Yii2\PHPStan\Rules\NestedViewExistenceValidationRule
	-
		class: MSpirkov\Yii2\PHPStan\Rules\QueryConditionValidationRule
	-
		class: MSpirkov\Yii2\PHPStan\Rules\UploadedFileInstanceValidationRule
	-
		class: MSpirkov\Yii2\PHPStan\Rules\ViewRenderExistenceValidationRule
	-
		class: MSpirkov\Yii2\PHPStan\Rules\WidgetPropertiesValidationRule
	-
		class: MSpirkov\Yii2\PHPStan\Rules\YiiCreateObjectValidationRule
	-
		class: MSpirkov\Yii2\PHPStan\Rules\NoComplexActionClassesRule
	-
		class: MSpirkov\Yii2\PHPStan\Rules\NoComplexControllerActionsRule
	-
		class: MSpirkov\Yii2\PHPStan\Rules\NoControllerActionCallsViaThisRule
	-
		class: MSpirkov\Yii2\PHPStan\Rules\NoDbQueriesInActionsRule
	-
		class: MSpirkov\Yii2\PHPStan\Rules\NoDbQueriesInControllersRule
	-
		class: MSpirkov\Yii2\PHPStan\Rules\NoDbQueriesInViewsRule
	-
		class: MSpirkov\Yii2\PHPStan\Rules\NoDirectSuperglobalsRule
	-
		class: MSpirkov\Yii2\PHPStan\Rules\NoDynamicQueryWhereRule
	-
		class: MSpirkov\Yii2\PHPStan\Rules\NoForbiddenYiiAppPropertiesRule
		arguments:
			allowedProperties: %mspirkovYii2.noForbiddenYiiAppProperties.allowedProperties%
	-
		class: MSpirkov\Yii2\PHPStan\Rules\NoRedundantExistenceCheckRule
	-
		class: MSpirkov\Yii2\PHPStan\Rules\NoRedundantHtmlEncodeRule
	-
		class: MSpirkov\Yii2\PHPStan\Rules\NoYiiAppPropertyMutationRule

	-
		class: MSpirkov\Yii2\PHPStan\Extensions\ApplicationComponentPropertiesClassReflectionExtension
		tags:
			- phpstan.broker.propertiesClassReflectionExtension
	-
		class: MSpirkov\Yii2\PHPStan\Extensions\ApplicationGetDynamicReturnTypeExtension
		tags:
			- phpstan.broker.dynamicMethodReturnTypeExtension
	-
		class: MSpirkov\Yii2\PHPStan\Extensions\ApplicationPropertyExpressionTypeResolverExtension
		tags:
			- phpstan.broker.expressionTypeResolverExtension
	-
		class: MSpirkov\Yii2\PHPStan\Extensions\ComponentBehaviorTypeSpecifyingExtension
		tags:
			- phpstan.typeSpecifier.methodTypeSpecifyingExtension
	-
		class: MSpirkov\Yii2\PHPStan\Extensions\ContainerGetDynamicReturnTypeExtension
		tags:
			- phpstan.broker.dynamicMethodReturnTypeExtension
	-
		class: MSpirkov\Yii2\PHPStan\Extensions\YiiAppExpressionTypeResolverExtension
		arguments:
			yiiAppTypes: %mspirkovYii2.yiiAppTypes%
		tags:
			- phpstan.broker.expressionTypeResolverExtension

	-
		class: MSpirkov\Yii2\PHPStan\Analyzers\ActionComplexityAnalyzer
		arguments:
			ifCount: %mspirkovYii2.actionComplexity.ifCount%
			foreachCount: %mspirkovYii2.actionComplexity.foreachCount%
			forCount: %mspirkovYii2.actionComplexity.forCount%
			whileCount: %mspirkovYii2.actionComplexity.whileCount%
			doWhileCount: %mspirkovYii2.actionComplexity.doWhileCount%
			switchCount: %mspirkovYii2.actionComplexity.switchCount%
			matchCount: %mspirkovYii2.actionComplexity.matchCount%
			ternaryCount: %mspirkovYii2.actionComplexity.ternaryCount%
			tryCatchCount: %mspirkovYii2.actionComplexity.tryCatchCount%
	-
		class: MSpirkov\Yii2\PHPStan\Analyzers\DbQueriesUsageAnalyzer
		arguments:
			yiiAppDbProperties: %mspirkovYii2.yiiAppDbProperties%
	-
		class: MSpirkov\Yii2\PHPStan\Analyzers\YiiAppAnalyzer
	-
		class: MSpirkov\Yii2\PHPStan\Analyzers\ActiveRecordRelationAnalyzer
	-
		class: MSpirkov\Yii2\PHPStan\Analyzers\ActiveRecordAttributeArrayAnalyzer
	-
		class: MSpirkov\Yii2\PHPStan\Analyzers\BaseObjectConfigAnalyzer
		arguments:
			skippedClasses: %mspirkovYii2.baseObjectConfigValidation.skippedClasses%
	-
		class: MSpirkov\Yii2\PHPStan\Analyzers\BaseObjectPropertyAnalyzer
	-
		class: MSpirkov\Yii2\PHPStan\Analyzers\ComponentConfigMethodAnalyzer
	-
		class: MSpirkov\Yii2\PHPStan\Analyzers\ComponentObjectConfigAnalyzer
	-
		class: MSpirkov\Yii2\PHPStan\Analyzers\ApplicationConfigAnalyzer
	-
		class: MSpirkov\Yii2\PHPStan\Analyzers\ContainerDefinitionAnalyzer
	-
		class: MSpirkov\Yii2\PHPStan\Analyzers\ControllerActionAnalyzer
		arguments:
			parser: @defaultAnalysisParser
	-
		class: MSpirkov\Yii2\PHPStan\Analyzers\ExpressionTypeAnalyzer
	-
		class: MSpirkov\Yii2\PHPStan\Analyzers\ModelAnalyzer
	-
		class: MSpirkov\Yii2\PHPStan\Analyzers\NamespaceAnalyzer
	-
		class: MSpirkov\Yii2\PHPStan\Analyzers\PathAnalyzer
	-
		class: MSpirkov\Yii2\PHPStan\Analyzers\QueryAnalyzer
	-
		class: MSpirkov\Yii2\PHPStan\Analyzers\SkippedClassesAnalyzer
	-
		class: MSpirkov\Yii2\PHPStan\Analyzers\ViewFileAnalyzer
		arguments:
			aliases: %mspirkovYii2.aliases%
			extensions: %mspirkovYii2.viewExtensions%
			viewPaths: %mspirkovYii2.viewPaths%
	-
		class: MSpirkov\Yii2\PHPStan\Finders\MethodReturnExpressionFinder
	-
		class: MSpirkov\Yii2\PHPStan\Visitors\MethodReturnExpressionVisitor
	-
		class: MSpirkov\Yii2\PHPStan\Resolvers\ConfigValueTypeResolver
		arguments:
			parser: @defaultAnalysisParser
	-
		class: MSpirkov\Yii2\PHPStan\Resolvers\ExpressionValueResolver
	-
		class: MSpirkov\Yii2\PHPStan\Config\ApplicationConfigProvider
		arguments:
			applicationConfigs: %mspirkovYii2.applicationConfigs%
			bootstrapFiles: %bootstrapFiles%
		tags:
			- phpstan.resultCacheMetaExtension
